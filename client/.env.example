# ==============================================================================
# My Maligai - Frontend Client Environment Variables
# ==============================================================================

# Production Backend API Base URL
# In production (e.g. Vercel), set this to your deployed backend URL + /api
# Example: https://my-maligai.onrender.com/api
VITE_API_BASE_URL=https://my-maligai.onrender.com/api

# Local Development Backend URL Proxy Target (Optional, defaults to http://localhost:5000)
VITE_DEV_BACKEND_URL=http://localhost:5000
