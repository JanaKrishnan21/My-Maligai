# ==============================================================================
# My Maligai - Grocery Shop Management System Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/mymaligai

# JWT Security
JWT_SECRET=mymaligai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# WhatsApp Cloud API Integration (Optional - Fallback web link used when empty)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v19.0

# Shop Defaults
DEFAULT_SHOP_NAME=My Maligai
DEFAULT_SHOP_PHONE=+919876543210
DEFAULT_REMINDER_DAYS=2
